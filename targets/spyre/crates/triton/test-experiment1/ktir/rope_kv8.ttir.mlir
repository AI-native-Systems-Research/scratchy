module {
  tt.func public @rope_fwd(%desc_x: !tt.ptr<f16> loc("desc_x"(#loc)), %desc_cos: !tt.ptr<f16> loc("desc_cos"(#loc)), %desc_sin: !tt.ptr<f16> loc("desc_sin"(#loc)), %desc_o: !tt.ptr<f16> loc("desc_o"(#loc))) attributes {noinline = false} {
    %c0_i32 = arith.constant 0 : i32 loc(#loc1)
    %c64_i64 = arith.constant 64 : i64 loc(#loc1)
    %c64_i32 = arith.constant 64 : i32 loc(#loc1)
    %c256_i32 = arith.constant 256 : i32 loc(#loc1)
    %c1_i64 = arith.constant 1 : i64 loc(#loc1)
    %c128_i64 = arith.constant 128 : i64 loc(#loc1)
    %c128_i32 = arith.constant 128 : i32 loc(#loc1)
    %y_dim = arith.constant 2048 : i32 loc(#loc25)
    %start_m = tt.get_program_id x : i32 loc(#loc26)
    %off_h = tt.get_program_id y : i32 loc(#loc27)
    %x_desc = tt.make_tensor_descriptor %desc_x, [%y_dim, %c128_i32], [%c128_i64, %c1_i64] : <f16>, <64x64xf16> loc(#loc28)
    %cos_desc = tt.make_tensor_descriptor %desc_cos, [%c256_i32, %c64_i32], [%c64_i64, %c1_i64] : <f16>, <64x64xf16> loc(#loc29)
    %sin_desc = tt.make_tensor_descriptor %desc_sin, [%c256_i32, %c64_i32], [%c64_i64, %c1_i64] : <f16>, <64x64xf16> loc(#loc30)
    %o_desc = tt.make_tensor_descriptor %desc_o, [%y_dim, %c128_i32], [%c128_i64, %c1_i64] : <f16>, <64x64xf16> loc(#loc31)
    %offs_m = arith.muli %off_h, %c256_i32 : i32 loc(#loc32)
    %offs_m_0 = arith.muli %start_m, %c64_i32 : i32 loc(#loc33)
    %offs_m_1 = arith.addi %offs_m, %offs_m_0 : i32 loc(#loc32)
    %x1 = tt.descriptor_load %x_desc[%offs_m_1, %c0_i32] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16> loc(#loc34)
    %x2 = tt.descriptor_load %x_desc[%offs_m_1, %c64_i32] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16> loc(#loc35)
    %c = tt.descriptor_load %cos_desc[%offs_m_0, %c0_i32] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16> loc(#loc36)
    %s = tt.descriptor_load %sin_desc[%offs_m_0, %c0_i32] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16> loc(#loc37)
    %0 = arith.mulf %x1, %c : tensor<64x64xf16> loc(#loc15)
    %1 = arith.mulf %x2, %s : tensor<64x64xf16> loc(#loc16)
    %2 = arith.subf %0, %1 : tensor<64x64xf16> loc(#loc15)
    tt.descriptor_store %o_desc[%offs_m_1, %c0_i32], %2 : !tt.tensordesc<64x64xf16>, tensor<64x64xf16> loc(#loc17)
    %3 = arith.mulf %x2, %c : tensor<64x64xf16> loc(#loc18)
    %4 = arith.mulf %x1, %s : tensor<64x64xf16> loc(#loc19)
    %5 = arith.addf %3, %4 : tensor<64x64xf16> loc(#loc18)
    tt.descriptor_store %o_desc[%offs_m_1, %c64_i32], %5 : !tt.tensordesc<64x64xf16>, tensor<64x64xf16> loc(#loc20)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
