// Upstream source:
//   https://github.com/flashinfer-ai/flashinfer
//     csrc/batch_attention_customize_config.jinja
// Pinned commit: {{ flashinfer_commit }}
//
// When you bump the pin, re-read upstream's jinja and reconcile this
// template against any struct/field additions to `PersistentParams`
// (silent breakage otherwise — the persistent runner reads the struct
// by layout).
//
// Template variables:
//   dtype_cpp            — C++ type alias for DTypeQ=DTypeKV=DTypeO.
//   head_dim             — HEAD_DIM_QK = HEAD_DIM_VO (single value).
//   use_logits_soft_cap  — bool; drives `StandardAttention<...>` arg.
//
// Pipeline invariants held fixed (not parametrized):
//   IdType          = int32_t                      (scratchy paged KV)
//   MaskMode        = kCausal                      (inference path)
//   PosEncodingMode = kNone                        (RoPE pre-baked)

#pragma once

#include <flashinfer/page.cuh>
#include <flashinfer/math.cuh>
#include <flashinfer/layout.cuh>
#include <flashinfer/utils.cuh>
#include <flashinfer/pos_enc.cuh>
#include <flashinfer/fastdiv.cuh>
#include <flashinfer/attention/variant_helper.cuh>
#include <flashinfer/profiler.cuh>

using namespace flashinfer;

template <bool UseLogitsSoftCap>
struct StandardAttention : AttentionVariantBase {
  float sm_scale_log2;
  float soft_cap_pre_tanh_scale;
  static constexpr bool use_logits_soft_cap = UseLogitsSoftCap;
  PROFILER_CLOSURE_PARAMS_DECL

  template <typename Params>
  __device__ __host__ StandardAttention(const Params& params, uint32_t /*batch_idx*/,
                                        uint8_t* /*smem_ptr*/) {
    if constexpr (UseLogitsSoftCap) {
      soft_cap_pre_tanh_scale = params.sm_scale * math::ptx_rcp(params.logits_soft_cap);
      sm_scale_log2 = math::log2e * params.logits_soft_cap;
    } else {
      sm_scale_log2 = params.sm_scale * math::log2e;
    }
  }

  REGISTER_LOGITS_TRANSFORM(params, logits, batch_idx, qo_idx, kv_idx, qo_head_idx, kv_head_idx, {
    if constexpr (UseLogitsSoftCap) {
      logits = float(math::tanh(logits * soft_cap_pre_tanh_scale));
    }
    return logits;
  })
};

using DTypeQ  = {{ dtype_cpp }};
using DTypeKV = {{ dtype_cpp }};
using DTypeO  = {{ dtype_cpp }};
using IdType  = int32_t;

constexpr int HEAD_DIM_QK = {{ head_dim }};
constexpr int HEAD_DIM_VO = {{ head_dim }};
constexpr auto POS_ENCODING_MODE = PosEncodingMode::kNone;

struct PersistentParams {
  using DTypeQ  = ::DTypeQ;
  using DTypeKV = ::DTypeKV;
  using DTypeO  = ::DTypeO;
  using IdType  = ::IdType;

  DTypeQ*  q;
  DTypeKV* k;
  DTypeKV* v;
  DTypeO*  o;
  DTypeO*  partial_o;
  float*   partial_lse;
  DTypeO*  final_o;
  float*   final_lse;

  IdType* q_indptr;
  IdType* kv_indptr;
  IdType* partial_indptr;
  IdType* kv_indices;
  IdType* q_len;
  IdType* kv_len;
  IdType* q_start;
  IdType* kv_start;
  IdType* kv_end;
  IdType* kv_head_idx_arr;
  IdType* work_indptr;
  IdType* len_kv_chunk;

  // State reduction
  IdType* merge_indptr;
  IdType* merge_o_indices;
  IdType* num_packed_qo_len;

  uint32_t num_kv_heads;
  uint_fastdiv gqa_group_size;
  uint_fastdiv page_size;

  uint32_t q_stride_n;
  uint32_t q_stride_h;
  uint32_t k_stride_page;
  uint32_t k_stride_h;
  uint32_t k_stride_n;
  uint32_t v_stride_page;
  uint32_t v_stride_h;
  uint32_t v_stride_n;

  float sm_scale;
  float logits_soft_cap;
  float v_scale;

  PROFILER_PARAMS_DECL
};
