//
// Per-tuple FlashInfer shim. Rendered at build time from this minijinja
// template by `scratchy-builder-cuda/build.rs` for every entry in
// `FLASHINFER_CONFIG_SET`. One copy of this file is compiled per tuple
// into a distinct translation unit inside `libflashinfer_attn.a`.
//
// Exports (per-tuple suffix `{{ sym_suffix }}`):
//   void*    fi_plan_{{ sym_suffix }}_new(...)
//   void     fi_plan_{{ sym_suffix }}_delete(void* handle)
//   void     fi_plan_{{ sym_suffix }}_set_io(handle, q, k, v, kv_indices, o)
//   int32_t  fi_run_{{ sym_suffix }}(void* handle, cudaStream_t stream)
//
// The `set_io` entry rebinds the I/O pointers on an already-built plan
// without touching workspaces or the computed schedule. Rust-side callers
// use it to reuse one plan across all transformer layers in a pass (K/V
// pointers change per layer; schedule does not).
//
// The unified plan populates BOTH `PersistentParams` slots (CTA_TILE_Q=128
// long-Q task and CTA_TILE_Q=16 short-Q task) so the same API handles
// sq=1 decode AND prefill. Claude4's original populated only task 0,
// which returned zeros for sq=1 — fixed here by always populating both.
//
// The forked `TwoStageHolisticPlanWithNumSm` below takes `num_sm` as a
// caller-supplied parameter, where upstream queries
// `cudaDevAttrMultiProcessorCount` and doubles it for 2-CTA-per-SM
// cooperative residency. Our caller already knows the correct cluster
// count from `TargetProfile::cooperative_grid_size()`; using the upstream
// planner here silently disagrees with the workspace-sizing path and
// trashes memory (see landmine #TODO in FLASHINFER_HANDOFF.md).

#include <cuda_bf16.h>
#include <cuda_fp16.h>
#include <cuda_runtime.h>

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <sstream>
#include <vector>

#include "{{ config_inc_filename }}"

#include <flashinfer/attention/persistent.cuh>
#include <flashinfer/attention/scheduler.cuh>

// Every symbol that isn't an `extern "C"` entry point lives in the
// per-tuple anonymous namespace below. Without this, multi-TU linking
// into `libflashinfer_attn.a` hits ODR collisions on `FlashInferPlan`,
// `offset_ptr`, and the forked planner. Function templates are implicitly
// inline and token-identical across tuples, but named types are not.
namespace fi_{{ sym_suffix }} {
namespace {

using namespace flashinfer;

template <typename T>
__host__ __device__ inline T* offset_ptr(void* base, size_t byte_offset) {
  return reinterpret_cast<T*>(static_cast<uint8_t*>(base) + byte_offset);
}

// Forked `TwoStageHolisticPlan` — see header comment in this template for
// why. The only diff from upstream is the `num_sm_in` trailing parameter
// replacing the internal `cudaDeviceGetAttribute(MultiProcessorCount) * 2`
// query. Vendored from FlashInfer commit {{ flashinfer_commit }}; when
// you bump the pin, re-read upstream `attention/scheduler.cuh` and
// reconcile this copy.
template <typename IdType>
inline cudaError_t TwoStageHolisticPlanWithNumSm(
    void* float_buffer, size_t float_workspace_size_in_bytes, void* int_buffer,
    void* page_locked_int_buffer, size_t int_workspace_size_in_bytes,
    HolisticPlanInfo<2>& plan_info, IdType* qo_indptr_h, IdType* kv_indptr_h,
    IdType* kv_len_arr_h, uint32_t batch_size, uint32_t num_qo_heads,
    uint32_t num_kv_heads, uint32_t head_dim, bool causal, cudaStream_t stream,
    int num_sm_in) {
  constexpr uint32_t NUM_TASKS = 2;
  const uint32_t CTA_TILE_Q_SIZES[NUM_TASKS] = {128, 16};

  uint32_t gqa_group_size = num_qo_heads / num_kv_heads;
  // ── DIFF FROM UPSTREAM: num_sm is caller-supplied. ──
  int num_sm = num_sm_in;

  // ── DIFF FROM UPSTREAM: track tight per-vector H2D ranges so the
  // final memcpy only copies actual data, not bump-allocated padding.
  // Upstream issues one cudaMemcpyAsync of `num_allocated_bytes()` —
  // each vector was sized to `max_total_num_works * 4 = 256 KB` but
  // holds only the written entries. For batch=1 decode that's ~24
  // vectors × 256 KB = 6 MB copied, 99% of which is uninitialized
  // padding. Collecting tight ranges drops per-step H2D to ~20 KB —
  // a 300× reduction on the decode fast path. ──
  struct H2DRange {
    int64_t offset;
    size_t bytes;
  };
  std::vector<H2DRange> h2d_ranges;
  auto record_copy = [&](int64_t offset, const auto& vec) {
    using T = typename std::remove_cv<
        typename std::remove_reference<decltype(vec[0])>::type>::type;
    size_t bytes = vec.size() * sizeof(T);
    if (bytes > 0) {
      h2d_ranges.push_back({offset, bytes});
    }
    CopyToPageLockedBuffer(page_locked_int_buffer, offset, vec);
  };

  std::vector<std::tuple<int, int, int>> idx_qo_kv_len_vec[NUM_TASKS];
  for (uint32_t i = 0; i < batch_size; ++i) {
    if (qo_indptr_h[i + 1] - qo_indptr_h[i] < 0) {
      std::ostringstream err_msg;
      err_msg << "qo_indptr[" << i + 1 << "]" << qo_indptr_h[i + 1] << " - qo_indptr[" << i
              << "]" << qo_indptr_h[i] << " should be non-negative";
      FLASHINFER_ERROR(err_msg.str());
    }

    int qo_len = qo_indptr_h[i + 1] - qo_indptr_h[i];
    int packed_qo_len = qo_len * gqa_group_size;
    int kv_len = kv_len_arr_h[i];

    if (packed_qo_len > static_cast<int>(CTA_TILE_Q_SIZES[1])) {
      idx_qo_kv_len_vec[0].push_back({i, qo_len, kv_len});
    } else {
      idx_qo_kv_len_vec[1].push_back({i, qo_len, kv_len});
    }
  }

  int cluster_size = 1;
  int num_clusters = num_sm / cluster_size;
  plan_info.num_blks_x = cluster_size;
  plan_info.num_blks_y = num_clusters;

  auto f = [](int x) {
    if (x <= 128) {
      return 128;
    }
    return ceil_div(x, 256) * 256;
  };

  MinHeap cluster_cost_heap(num_clusters);
  AlignedAllocator int_allocator(int_buffer, int_workspace_size_in_bytes);

  const int max_total_num_works = 65536;
  const int max_num_kv_splits =
      4 * num_clusters * cluster_size * (CTA_TILE_Q_SIZES[0] + CTA_TILE_Q_SIZES[1]);

  int64_t total_kv_lens = 0;
  for (uint32_t task = 0; task < NUM_TASKS; ++task) {
    int cluster_tile_q = CTA_TILE_Q_SIZES[task] * cluster_size;
    for (auto& [_, qo_len, kv_len] : idx_qo_kv_len_vec[task]) {
      int packed_qo_len = qo_len * gqa_group_size;
      int num_qo_tiles = ceil_div(packed_qo_len, cluster_tile_q);
      for (int qo_tile_idx = num_qo_tiles - 1; qo_tile_idx >= 0; --qo_tile_idx) {
        int effective_kv_len =
            causal ? packed_causal_kv_end(qo_len, kv_len, qo_tile_idx, cluster_tile_q,
                                          num_qo_tiles, gqa_group_size)
                   : kv_len;
        total_kv_lens += effective_kv_len;
      }
    }
  }

  int partial_o_nnz = 0;
  std::vector<IdType> merge_indptr, merge_o_indices, num_expand_qo_len_vec;
  std::vector<IdType> cluster_len_kv_chunk(NUM_TASKS, 0);
  merge_indptr.push_back(partial_o_nnz);
  for (uint32_t task = 0; task < NUM_TASKS; ++task) {
    int cluster_tile_q = CTA_TILE_Q_SIZES[task] * cluster_size;
    int kv_len_limit = f(std::max(ceil_div(total_kv_lens * num_kv_heads, num_clusters), 1L));
    if (cluster_tile_q >= 64) {
      kv_len_limit /= std::min(num_kv_heads, 2U);
    }
    cluster_len_kv_chunk[task] = kv_len_limit;
    std::vector<std::vector<IdType>> cluster_q_indptr(num_clusters, std::vector<IdType>()),
        cluster_kv_indptr(num_clusters, std::vector<IdType>()),
        cluster_q_len(num_clusters, std::vector<IdType>()),
        cluster_kv_len(num_clusters, std::vector<IdType>()),
        cluster_q_start(num_clusters, std::vector<IdType>()),
        cluster_kv_start(num_clusters, std::vector<IdType>()),
        cluster_kv_end(num_clusters, std::vector<IdType>()),
        cluster_kv_head_idx(num_clusters, std::vector<IdType>()),
        cluster_partial_indptr(num_clusters, std::vector<IdType>());

    for (auto& [i, qo_len, kv_len] : idx_qo_kv_len_vec[task]) {
      int packed_qo_len = qo_len * gqa_group_size;
      int num_qo_tiles = ceil_div(packed_qo_len, cluster_tile_q);
      for (int qo_tile_idx = 0; qo_tile_idx < num_qo_tiles; ++qo_tile_idx) {
        int remaining_len =
            causal ? packed_causal_kv_end(qo_len, kv_len, qo_tile_idx, cluster_tile_q,
                                          num_qo_tiles, gqa_group_size)
                   : kv_len;
        int kv_start = 0;
        bool split_kv = remaining_len > kv_len_limit;
        int num_kv_tiles = split_kv ? ceil_div(remaining_len, kv_len_limit) : 1;
        int row_tile_size =
            std::min(cluster_tile_q, packed_qo_len - qo_tile_idx * cluster_tile_q);
        bool zero_kv_len = (remaining_len == 0);
        while (remaining_len > 0 || zero_kv_len) {
          int actual_len = std::min(remaining_len, kv_len_limit);
          for (uint32_t kv_head_idx = 0; kv_head_idx < num_kv_heads; ++kv_head_idx) {
            auto [cluster_idx, accum_cost] = cluster_cost_heap.pop();
            cluster_cost_heap.insert(
                {cluster_idx, accum_cost + cost_function(cluster_tile_q, actual_len)});
            cluster_q_len[cluster_idx].push_back(qo_len);
            cluster_kv_len[cluster_idx].push_back(kv_len);
            cluster_q_indptr[cluster_idx].push_back(qo_indptr_h[i]);
            cluster_kv_indptr[cluster_idx].push_back(kv_indptr_h[i]);
            cluster_partial_indptr[cluster_idx].push_back(partial_o_nnz);
            cluster_q_start[cluster_idx].push_back(qo_tile_idx * cluster_tile_q);
            cluster_kv_start[cluster_idx].push_back(kv_start);
            cluster_kv_end[cluster_idx].push_back(kv_start + actual_len);
            cluster_kv_head_idx[cluster_idx].push_back(kv_head_idx);
          }
          remaining_len -= actual_len;
          zero_kv_len = (remaining_len == 0);
          kv_start += actual_len;
          if (zero_kv_len) {
            break;
          }
        }
        if (split_kv) {
          for (int row = 0; row < row_tile_size; ++row) {
            merge_indptr.push_back(merge_indptr.back() + num_kv_tiles);
            auto q = (qo_tile_idx * cluster_tile_q + row) / gqa_group_size,
                 r = (qo_tile_idx * cluster_tile_q + row) % gqa_group_size;
            merge_o_indices.push_back((qo_indptr_h[i] + q) * num_kv_heads * gqa_group_size + r);
          }
          partial_o_nnz += row_tile_size * num_kv_tiles;
        }
      }
    }

    std::vector<IdType> work_indptr_vec(num_clusters + 1, 0);
    for (int i = 0; i < num_clusters; ++i) {
      work_indptr_vec[i + 1] = work_indptr_vec[i] + cluster_q_indptr[i].size();
    }
    int total_num_works = work_indptr_vec.back();
    if (total_num_works > max_total_num_works) {
      std::ostringstream err_msg;
      err_msg << "total_num_works (#q tiles * #kv tiles) " << total_num_works
              << " exceeds max_total_num_works " << max_total_num_works;
      FLASHINFER_ERROR(err_msg.str());
    }
    auto q_indptr_vec = flatten(cluster_q_indptr, total_num_works);
    auto kv_indptr_vec = flatten(cluster_kv_indptr, total_num_works);
    auto partial_indptr_vec = flatten(cluster_partial_indptr, total_num_works);
    auto q_len_vec = flatten(cluster_q_len, total_num_works);
    auto kv_len_vec = flatten(cluster_kv_len, total_num_works);
    auto q_start_vec = flatten(cluster_q_start, total_num_works);
    auto kv_start_vec = flatten(cluster_kv_start, total_num_works);
    auto kv_end_vec = flatten(cluster_kv_end, total_num_works);
    auto kv_head_idx_vec = flatten(cluster_kv_head_idx, total_num_works);

    plan_info.tasks[task].q_indptr_offset =
        int_allocator.aligned_alloc_offset(sizeof(IdType) * max_total_num_works, 16, "q_indptr");
    plan_info.tasks[task].kv_indptr_offset = int_allocator.aligned_alloc_offset(
        sizeof(IdType) * max_total_num_works, 16, "kv_indptr");
    plan_info.tasks[task].partial_indptr_offset = int_allocator.aligned_alloc_offset(
        sizeof(IdType) * max_total_num_works, 16, "partial_indptr");
    plan_info.tasks[task].q_len_offset =
        int_allocator.aligned_alloc_offset(sizeof(IdType) * max_total_num_works, 16, "q_len");
    plan_info.tasks[task].kv_len_offset =
        int_allocator.aligned_alloc_offset(sizeof(IdType) * max_total_num_works, 16, "kv_len");
    plan_info.tasks[task].q_start_offset =
        int_allocator.aligned_alloc_offset(sizeof(IdType) * max_total_num_works, 16, "q_start");
    plan_info.tasks[task].kv_start_offset =
        int_allocator.aligned_alloc_offset(sizeof(IdType) * max_total_num_works, 16, "kv_start");
    plan_info.tasks[task].kv_end_offset =
        int_allocator.aligned_alloc_offset(sizeof(IdType) * max_total_num_works, 16, "kv_end");
    plan_info.tasks[task].kv_head_idx_offset = int_allocator.aligned_alloc_offset(
        sizeof(IdType) * max_total_num_works, 16, "kv_head_idx");
    plan_info.tasks[task].work_indptr_offset = int_allocator.aligned_alloc_offset(
        sizeof(IdType) * max_total_num_works, 16, "work_indptr");

    record_copy(plan_info.tasks[task].q_indptr_offset, q_indptr_vec);
    record_copy(plan_info.tasks[task].kv_indptr_offset, kv_indptr_vec);
    record_copy(plan_info.tasks[task].partial_indptr_offset, partial_indptr_vec);
    record_copy(plan_info.tasks[task].q_len_offset, q_len_vec);
    record_copy(plan_info.tasks[task].kv_len_offset, kv_len_vec);
    record_copy(plan_info.tasks[task].q_start_offset, q_start_vec);
    record_copy(plan_info.tasks[task].kv_start_offset, kv_start_vec);
    record_copy(plan_info.tasks[task].kv_end_offset, kv_end_vec);
    record_copy(plan_info.tasks[task].kv_head_idx_offset, kv_head_idx_vec);
    record_copy(plan_info.tasks[task].work_indptr_offset, work_indptr_vec);
  }
  plan_info.len_kv_chunk_offset =
      int_allocator.aligned_alloc_offset(sizeof(IdType) * NUM_TASKS, 16, "len_kv_chunk");
  record_copy(plan_info.len_kv_chunk_offset, cluster_len_kv_chunk);

  if ((int)merge_indptr.size() > max_num_kv_splits) {
    std::ostringstream err_msg;
    err_msg << "Number of kv splits " << merge_indptr.size() << " exceeds max buffer size "
            << max_num_kv_splits << ". Please increase the threshold.";
    FLASHINFER_ERROR(err_msg.str());
  }

  num_expand_qo_len_vec.push_back(merge_indptr.size() - 1);
  plan_info.merge_indptr_offset =
      int_allocator.aligned_alloc_offset(sizeof(IdType) * max_num_kv_splits, 16, "merge_indptr");
  plan_info.merge_o_indices_offset = int_allocator.aligned_alloc_offset(
      sizeof(IdType) * max_num_kv_splits, 16, "merge_o_indices");
  plan_info.num_qo_len_offset =
      int_allocator.aligned_alloc_offset(sizeof(IdType), 16, "num_qo_len_offset");
  record_copy(plan_info.merge_indptr_offset, merge_indptr);
  record_copy(plan_info.merge_o_indices_offset, merge_o_indices);
  record_copy(plan_info.num_qo_len_offset, num_expand_qo_len_vec);

  // ── DIFF FROM UPSTREAM: tight per-vector H2D memcpys instead of
  // one large `num_allocated_bytes` memcpy. Each vector was allocated
  // at a max-sized offset for stable kernel reads, but only the
  // populated prefix is meaningful — copying the padding is wasted
  // PCIe traffic on the decode fast path. ──
  for (const auto& r : h2d_ranges) {
    FLASHINFER_CUDA_CALL(cudaMemcpyAsync(
        static_cast<char*>(int_buffer) + r.offset,
        static_cast<const char*>(page_locked_int_buffer) + r.offset,
        r.bytes, cudaMemcpyHostToDevice, stream));
  }
  constexpr size_t sizeof_dtype_o = sizeof(DTypeO);

  AlignedAllocator float_allocator(float_buffer, float_workspace_size_in_bytes);
  plan_info.partial_o_offset = float_allocator.aligned_alloc_offset(
      max_num_kv_splits * sizeof_dtype_o * head_dim * num_kv_heads, 16, "holistic_partial_o");
  plan_info.partial_lse_offset = float_allocator.aligned_alloc_offset(
      max_num_kv_splits * sizeof(float) * num_kv_heads, 16, "holistic_partial_lse");

  return cudaSuccess;
}

struct FlashInferPlan {
  void* float_ws_d;
  void* int_ws_d;
  void* int_ws_h;
  size_t float_ws_bytes;
  size_t int_ws_bytes;
  int32_t num_qo_heads;
  int32_t num_kv_heads;
  int32_t head_dim;
  int32_t page_size;
  int32_t target_num_clusters;
  PersistentParams params_1;
  PersistentParams params_2;
  int32_t num_blks_x;
  int32_t num_blks_y;
};

}  // namespace
}  // namespace fi_{{ sym_suffix }}

extern "C" void* fi_plan_{{ sym_suffix }}_new(
    DTypeQ* q, DTypeKV* k, DTypeKV* v, int32_t* kv_indices, DTypeO* o,
    int32_t seq_len, int32_t seqlen_k,
    int32_t num_qo_heads, int32_t num_kv_heads, int32_t head_dim,
    int32_t page_size, int32_t num_pages,
    int32_t target_num_clusters, size_t float_ws_bytes, size_t int_ws_bytes,
    float sm_scale, float logits_soft_cap, cudaStream_t stream, int32_t* rc_out) {
  using Plan = fi_{{ sym_suffix }}::FlashInferPlan;
  if (head_dim != HEAD_DIM_QK) {
    std::fprintf(stderr,
                 "fi_plan_{{ sym_suffix }}_new: head_dim=%d != compiled HEAD_DIM_QK=%d\n",
                 head_dim, HEAD_DIM_QK);
    *rc_out = -5;
    return nullptr;
  }

  Plan* out = new Plan();
  out->float_ws_d = nullptr;
  out->int_ws_d = nullptr;
  out->int_ws_h = nullptr;

  auto fail = [&](int code) -> void* {
    *rc_out = code;
    if (out->float_ws_d) cudaFree(out->float_ws_d);
    if (out->int_ws_d) cudaFree(out->int_ws_d);
    if (out->int_ws_h) cudaFreeHost(out->int_ws_h);
    delete out;
    return nullptr;
  };
  if (cudaMalloc(&out->float_ws_d, float_ws_bytes) != cudaSuccess) return fail(-1);
  if (cudaMalloc(&out->int_ws_d, int_ws_bytes) != cudaSuccess) return fail(-2);
  if (cudaMallocHost(&out->int_ws_h, int_ws_bytes) != cudaSuccess) return fail(-3);

  IdType qo_indptr_h[2] = {0, seq_len};
  IdType kv_indptr_h[2] = {0, num_pages};
  IdType kv_len_h[1] = {seqlen_k};

  HolisticPlanInfo<2> plan_info;
  cudaError_t status = fi_{{ sym_suffix }}::TwoStageHolisticPlanWithNumSm<IdType>(
      out->float_ws_d, float_ws_bytes, out->int_ws_d, out->int_ws_h, int_ws_bytes,
      plan_info, qo_indptr_h, kv_indptr_h, kv_len_h, /*batch_size=*/1,
      num_qo_heads, num_kv_heads, head_dim, /*causal=*/true, stream,
      /*num_sm_in=*/target_num_clusters);
  if (status != cudaSuccess) {
    std::fprintf(stderr, "fi_plan_{{ sym_suffix }}_new: plan failed: %s\n",
                 cudaGetErrorString(status));
    return fail(-4);
  }

  IdType* len_kv_chunk_d =
      fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.len_kv_chunk_offset);

  PersistentParams* plist[2] = {&out->params_1, &out->params_2};
  for (int i = 0; i < 2; ++i) {
    PersistentParams& p = *plist[i];
    p.q = q; p.k = k; p.v = v; p.kv_indices = kv_indices;
    p.o = o; p.final_o = o; p.final_lse = nullptr;
    p.partial_o =
        fi_{{ sym_suffix }}::offset_ptr<DTypeO>(out->float_ws_d, plan_info.partial_o_offset);
    p.partial_lse =
        fi_{{ sym_suffix }}::offset_ptr<float>(out->float_ws_d, plan_info.partial_lse_offset);

    p.q_indptr =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].q_indptr_offset);
    p.kv_indptr =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].kv_indptr_offset);
    p.partial_indptr = fi_{{ sym_suffix }}::offset_ptr<IdType>(
        out->int_ws_d, plan_info.tasks[i].partial_indptr_offset);
    p.q_len =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].q_len_offset);
    p.kv_len =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].kv_len_offset);
    p.q_start =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].q_start_offset);
    p.kv_start =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].kv_start_offset);
    p.kv_end =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.tasks[i].kv_end_offset);
    p.kv_head_idx_arr = fi_{{ sym_suffix }}::offset_ptr<IdType>(
        out->int_ws_d, plan_info.tasks[i].kv_head_idx_offset);
    p.work_indptr = fi_{{ sym_suffix }}::offset_ptr<IdType>(
        out->int_ws_d, plan_info.tasks[i].work_indptr_offset);
    p.len_kv_chunk = len_kv_chunk_d + i;

    p.merge_indptr =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.merge_indptr_offset);
    p.merge_o_indices =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.merge_o_indices_offset);
    p.num_packed_qo_len =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(out->int_ws_d, plan_info.num_qo_len_offset);

    p.num_kv_heads = static_cast<uint32_t>(num_kv_heads);
    p.gqa_group_size = uint_fastdiv(static_cast<uint32_t>(num_qo_heads / num_kv_heads));
    p.page_size = uint_fastdiv(static_cast<uint32_t>(page_size));
    p.q_stride_n = static_cast<uint32_t>(num_qo_heads * head_dim);
    p.q_stride_h = static_cast<uint32_t>(head_dim);
    p.k_stride_page = static_cast<uint32_t>(page_size * num_kv_heads * head_dim);
    p.k_stride_n = static_cast<uint32_t>(num_kv_heads * head_dim);
    p.k_stride_h = static_cast<uint32_t>(head_dim);
    p.v_stride_page = static_cast<uint32_t>(page_size * num_kv_heads * head_dim);
    p.v_stride_n = static_cast<uint32_t>(num_kv_heads * head_dim);
    p.v_stride_h = static_cast<uint32_t>(head_dim);
    p.sm_scale = sm_scale;
    p.v_scale = 1.0f;
    p.logits_soft_cap = logits_soft_cap;
  }
  out->float_ws_bytes = float_ws_bytes;
  out->int_ws_bytes = int_ws_bytes;
  out->num_qo_heads = num_qo_heads;
  out->num_kv_heads = num_kv_heads;
  out->head_dim = head_dim;
  out->page_size = page_size;
  out->target_num_clusters = target_num_clusters;
  out->num_blks_x = plan_info.num_blks_x;
  out->num_blks_y = plan_info.num_blks_y;
  *rc_out = 0;
  return out;
}

// Re-run the scheduler on an existing plan WITHOUT reallocating workspaces.
// This is the graph-compatible fast path: the caller updates `int_ws_h`
// (pinned) and issues H2D memcpy to `int_ws_d` on `stream`. A captured
// CUDA graph that recorded the original `plan_new` memcpy on the same
// stream will replay this one instead — the kernel's scheduling pointers
// (PersistentParams fields like `kv_len`, `kv_indptr`, etc.) reference
// stable offsets inside `int_ws_d` so the fresh data propagates.
//
// Call this on the compute stream BEFORE graph launch at each decode step.
// The kernel launch inside the graph then reads updated scheduling.
extern "C" int32_t fi_plan_{{ sym_suffix }}_replan(
    void* handle, int32_t seq_len, int32_t seqlen_k,
    int32_t num_pages, cudaStream_t stream) {
  if (!handle) return -1;
  auto* plan = static_cast<fi_{{ sym_suffix }}::FlashInferPlan*>(handle);

  IdType qo_indptr_h[2] = {0, seq_len};
  IdType kv_indptr_h[2] = {0, num_pages};
  IdType kv_len_h[1] = {seqlen_k};

  HolisticPlanInfo<2> plan_info;
  cudaError_t status = fi_{{ sym_suffix }}::TwoStageHolisticPlanWithNumSm<IdType>(
      plan->float_ws_d, plan->float_ws_bytes,
      plan->int_ws_d, plan->int_ws_h, plan->int_ws_bytes,
      plan_info, qo_indptr_h, kv_indptr_h, kv_len_h, /*batch_size=*/1,
      plan->num_qo_heads, plan->num_kv_heads, plan->head_dim,
      /*causal=*/true, stream, plan->target_num_clusters);
  if (status != cudaSuccess) return -2;

  // Update grid dims (typically stable for persistent kernels, but
  // defensively refresh in case the planner changes split strategy).
  plan->num_blks_x = plan_info.num_blks_x;
  plan->num_blks_y = plan_info.num_blks_y;

  // Refresh scheduling-pointer offsets in PersistentParams. The actual
  // data was written to int_ws_d by the planner's internal memcpy.
  IdType* len_kv_chunk_d =
      fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.len_kv_chunk_offset);

  PersistentParams* plist[2] = {&plan->params_1, &plan->params_2};
  for (int i = 0; i < 2; ++i) {
    PersistentParams& p = *plist[i];
    p.q_indptr =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].q_indptr_offset);
    p.kv_indptr =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].kv_indptr_offset);
    p.partial_indptr = fi_{{ sym_suffix }}::offset_ptr<IdType>(
        plan->int_ws_d, plan_info.tasks[i].partial_indptr_offset);
    p.q_len =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].q_len_offset);
    p.kv_len =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].kv_len_offset);
    p.q_start =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].q_start_offset);
    p.kv_start =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].kv_start_offset);
    p.kv_end =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.tasks[i].kv_end_offset);
    p.kv_head_idx_arr = fi_{{ sym_suffix }}::offset_ptr<IdType>(
        plan->int_ws_d, plan_info.tasks[i].kv_head_idx_offset);
    p.work_indptr = fi_{{ sym_suffix }}::offset_ptr<IdType>(
        plan->int_ws_d, plan_info.tasks[i].work_indptr_offset);
    p.len_kv_chunk = len_kv_chunk_d + i;

    p.merge_indptr =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.merge_indptr_offset);
    p.merge_o_indices =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.merge_o_indices_offset);
    p.num_packed_qo_len =
        fi_{{ sym_suffix }}::offset_ptr<IdType>(plan->int_ws_d, plan_info.num_qo_len_offset);

    p.partial_o =
        fi_{{ sym_suffix }}::offset_ptr<DTypeO>(plan->float_ws_d, plan_info.partial_o_offset);
    p.partial_lse =
        fi_{{ sym_suffix }}::offset_ptr<float>(plan->float_ws_d, plan_info.partial_lse_offset);
  }
  return 0;
}

// Rebind the five I/O pointers on an existing plan without re-planning.
// The schedule (indptrs, workspaces, cluster counts) depends only on
// (seq_len, seqlen_k, num_pages, head_dim, num_kv_heads, num_qo_heads,
//  target_num_clusters) — none of which change across layers within one
// forward pass. K/V change per layer; Q/O change per layer (fresh
// allocations); kv_indices is the same for all layers of a given
// sequence. The caller updates k/v/q/o per layer and kv_indices once.
extern "C" void fi_plan_{{ sym_suffix }}_set_io(
    void* handle, DTypeQ* q, DTypeKV* k, DTypeKV* v,
    int32_t* kv_indices, DTypeO* o) {
  if (!handle) return;
  auto* plan = static_cast<fi_{{ sym_suffix }}::FlashInferPlan*>(handle);
  PersistentParams* plist[2] = {&plan->params_1, &plan->params_2};
  for (int i = 0; i < 2; ++i) {
    PersistentParams& p = *plist[i];
    p.q = q;
    p.k = k;
    p.v = v;
    p.kv_indices = kv_indices;
    p.o = o;
    p.final_o = o;
  }
}

extern "C" void fi_plan_{{ sym_suffix }}_delete(void* handle) {
  if (!handle) return;
  auto* plan = static_cast<fi_{{ sym_suffix }}::FlashInferPlan*>(handle);
  if (plan->float_ws_d) cudaFree(plan->float_ws_d);
  if (plan->int_ws_d) cudaFree(plan->int_ws_d);
  if (plan->int_ws_h) cudaFreeHost(plan->int_ws_h);
  delete plan;
}

extern "C" int32_t fi_run_{{ sym_suffix }}(void* handle, cudaStream_t stream) {
  auto* plan = static_cast<fi_{{ sym_suffix }}::FlashInferPlan*>(handle);
  cudaError_t st = flashinfer::BatchPagedAttentionPersistent<
      /*CTA_TILE_Q_1=*/128, /*CTA_TILE_Q_2=*/16, HEAD_DIM_QK, HEAD_DIM_VO,
      flashinfer::MaskMode::kCausal,
      StandardAttention</*UseLogitsSoftCap=*/{{ 'true' if use_logits_soft_cap else 'false' }}>,
      PersistentParams>(
      plan->params_1, plan->params_2,
      plan->num_blks_x, plan->num_blks_y, stream);
  return st == cudaSuccess ? 0 : -1;
}
