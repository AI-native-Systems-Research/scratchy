/// instr_count:17
// @RegInit:c0:"0x00000000000000000000000000000000":c1:"0x00010001000100010001000100010001":c2:"0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"

//* E = fpl^-0.5 using Newton Raphson algorithm*

//stream in data and save it to reg[2-3]
LOGICAL mask=255 src0=in0 imm=1 src2=0.0 tgtrf=p0_0 unrlfldtgt=1 unroll=x2

//get [e] = e - bias, extract exponent and then subtract the bias, save to reg[8-9]
EE mask=255 src0=p0_0 imm=0 src2=0.0 tgtrf=t0_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=x2 mode=prec
//get 1.f, insertex(fx, 0) and save to reg[6-7]
IME mask=255 src0=c0 imm=0 src2=p0_0 tgtrf=t1_0 unrlfldsrc2=1 unrlfldtgt=1 unroll=x2 mode=prec

// [e] >> 1 (equivalent to [e]/2) and save to reg[14-15]
SHR mask=255 src0=t0_0 imm=1 src2=0.0 tgtrf=t2_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=x2 mode=prec

// mask the last bit of [e], 0 for even exponent and 1 for odd exponent and save to reg[8-9]
LOGICAL mask=255 src0=t0_0 imm=0 src2=c1 tgtrf=t0_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=x2
//fre=sqrtest(D), then save to reg[10-11]
FEST mask=255 src0=p0_0 imm=5 src2=0.0 tgtrf=t3_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=x2 mode=prec
//get 0b1.f for even [e], get 0b0.1f (= 1.f/2) for odd [e], and save to reg[6-7]
IME  mask=255 src0=t0_0 imm=2 src2=t1_0 tgtrf=t1_0 unrlfldsrc0=1 unrlfldsrc2=1 unrlfldtgt=1 unroll=x2 mode=prec

//iteration by 6 for 0.5*fre(3+(-fx)*fre^2)
MVLOOPCNT imm=6
//ft = fre * fre; save to reg[12-13].
FMUL mask=255 src0=t3_0 src1=t3_0 src2=0.0 tgtrf=t4_0 unrlfldsrc0=1 unrlfldsrc1=1 unrlfldtgt=1 unroll=x2 mode=prec
//ft = (3.0 - fx*ft), save to reg[12-13]
FNMS mask=255 src0=t1_0 src1=t4_0 src2=3.0 tgtrf=t4_0 unrlfldsrc0=1 unrlfldsrc1=1 unrlfldtgt=1 unroll=x2 mode=prec
//fre = fre*ft*0.5; save to reg[10-11].
FMUL mask=255 src0=t3_0 src1=t4_0 src2=muldiv2 tgtrf=t3_0 unrlfldsrc0=1 unrlfldsrc1=1 unrlfldtgt=1 unroll=x2 mode=prec be=be

// insertexp(fre, reg[6], -) (divide fre by 2 for odd [e]) and save reg[10-11]
IME mask=255 src0=t0_0 imm=2 src2=t3_0 tgtrf=t3_0 unrlfldsrc0=1 unrlfldsrc2=1 unrlfldtgt=1 unroll=x2 mode=prec
// insertexp(fre, [e], -) to get final result and send to lx-su
IME mask=255 src0=t2_0 imm=2 src2=t3_0 tgtrf=t2_0 unrlfldsrc0=1 unrlfldsrc2=1 unrlfldtgt=1 unroll=x2 mode=prec

//
//Corner case handling & data write

//FCMP x<=0, true ffff; false R14 value;
FCMP mask=255 src0=p0_0 imm=0x7 src2=c0 mode=prec //no unroll-one flag
//select; flag=1 select x (R4=ffff), flag=0 select z(R14=data)
SELECT mask=255 src0=t2_0 imm=0x0 src2=c2 tgtencoding=lx fwdencoding=result mode=prec

//FCMP x<=0, true ffff; false R15 value;
FCMP mask=255 src0=p0_1 imm=0x7 src2=c0 //no unroll-one flag mode=prec
//select; flag=1 select x (R4=ffff), flag=0 select z(R15=data)
SELECT mask=255 src0=t2_1 imm=0x0 src2=c2 tgtencoding=lx fwdencoding=result mode=prec // be=be
