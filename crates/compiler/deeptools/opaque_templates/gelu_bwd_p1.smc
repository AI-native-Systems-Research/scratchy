/// instr_count:15
// calc alpha
// x --> p0
LOGICAL mask=255 src0=in0 imm=1 src2=0.0 tgtrf=p0_0 unrlfldtgt=1 unroll=unroll
// x^2 --> t0
FMUL    mask=255 src0=p0_0 src1=p0_0 src2=0.0 tgtrf=t0_0 unrlfldsrc0=1 unrlfldsrc1=1 unrlfldtgt=1 unroll=unroll
// x^2*c1(0.0356774)+c2(0.797885) --> t1
FMA     mask=255 src0=c1 src1=t0_0 src2=c2 tgtrf=t1_0 unrlfldsrc1=1 unrlfldtgt=1 unroll=unroll
// x^3*c1(0.0356774)+c2(0.797885)*x --> t1
FMUL    mask=255 src0=t1_0 src1=p0_0 src2=0.0 tgtrf=t1_0 unrlfldsrc0=1 unrlfldsrc1=1 unrlfldtgt=1 unroll=unroll

// calc delta
// exp^alpha --> t2 (cexp: 0x54E354E354E354E354E354E354E354E3)
FMUL    mask=255 src0=t1_0 src1=cexp src2=0.0 tgtrf=t2_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=unroll
ICVT    mask=255 src0=icvtconst imm=0x7 src2=t2_0 tgtrf=t2_0 unrlfldsrc2=1 unrlfldtgt=1 unroll=unroll
// -alpha --> t3
FNMS    mask=255 src0=t1_0 src1=1.0 src2=0.0 tgtrf=t3_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=unroll
// exp^(-alpha) --> t3 (cexp: 0x54E354E354E354E354E354E354E354E3)
FMUL    mask=255 src0=t3_0 src1=cexp src2=0.0 tgtrf=t3_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=unroll
ICVT    mask=255 src0=icvtconst imm=0x7 src2=t3_0 tgtrf=t3_0 unrlfldsrc2=1 unrlfldtgt=1 unroll=unroll
// exp^alpha + exp^(-alpha) --> SFP
FMA mask=255 src0=t2_0 src1=1.0 src2=t3_0 tgtencoding=sfp fwdencoding=out0 unrlfldsrc0=1 unrlfldsrc2=1 unroll=unroll

// calc beta
// c4(0.0535161)*x^2 + c5(0.398942) --> t4
FMA     mask=255 src0=c4 src1=t0_0 src2=c5 tgtrf=t2_0 unrlfldsrc1=1 unrlfldtgt=1 unroll=unroll
// c4(0.0535161)*x^3 + c5(0.398942)*x --> t4
FMUL    mask=255 src0=t2_0 src1=p0_0 src2=0.0 tgtencoding=sfp fwdencoding=out0 unrlfldsrc0=1 unrlfldsrc1=1 unroll=unroll

// calc gamma
// tanh(alpha)
FEST    mask=255 src0=t1_0 imm=0x8 src2=0.0 tgtrf=t2_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=unroll
FEST    mask=255 src0=t1_0 imm=0x9 src2=0.0 tgtrf=t3_0 unrlfldsrc0=1 unrlfldtgt=1 unroll=unroll
FMA     mask=255 src0=t1_0 src1=t2_0 src2=t3_0 tgtencoding=sfp fwdencoding=out0 unrlfldsrc0=1 unrlfldsrc1=1 unrlfldsrc2=1 unroll=unroll